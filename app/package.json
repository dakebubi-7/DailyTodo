{
  "name": "daily-todo",
  "version": "1.0.0",
  "description": "A beautiful transparent daily todo desktop app",
  "author": "DailyTodo",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "electron:build": "electron-vite build && electron-builder",
    "dist": "electron-vite build && electron-builder --win dir",
    "verify:companion": "tsx electron/obsidianCompanion.verify.ts",
    "verify:window-mode": "tsx electron/windowMode.verify.ts",
    "verify:settings-sync": "tsx scripts/verify-settings-sync.ts",
    "verify:delete-review": "tsx scripts/verify-delete-review.ts",
    "verify:review-fields": "tsx scripts/verify-review-empty-fields.ts",
    "verify:no-captures": "tsx scripts/verify-no-captures-feature.ts",
    "verify:daily-command": "tsx scripts/verify-daily-command-editor.ts",
    "verify:ux-polish": "tsx scripts/verify-ux-polish.ts",
    "verify:context-menu": "tsx scripts/verify-context-menu.ts",
    "verify:markdown-editor": "tsx scripts/verify-markdown-editor.ts",
    "verify:rc-sync": "tsx scripts/verify-rc-sync.ts",
    "verify:rc-strings": "tsx scripts/verify-rc-strings.ts",
    "verify:rc-ui": "tsx scripts/verify-rc-ui-regressions.ts",
    "verify:renderer-route": "tsx scripts/verify-renderer-route.ts",
    "verify:main-window-structure": "tsx scripts/verify-main-window-structure.ts",
    "verify:widget-structure": "npm run verify:renderer-route && npm run verify:main-window-structure",
    "verify:ai-markers": "tsx scripts/verify-ai-markers.ts",
    "verify:ai-hash": "tsx scripts/verify-ai-hash.ts",
    "verify:scan-decision": "tsx scripts/verify-scan-decision.ts",
    "verify:ai-stats": "tsx scripts/verify-ai-stats.ts",
    "verify:ai-settings": "tsx scripts/verify-ai-settings.ts",
    "verify:profile-ops": "tsx scripts/verify-profile-ops.ts",
    "verify:section-config": "tsx scripts/verify-section-config.ts",
    "verify:openai-client": "tsx scripts/verify-openai-client.ts",
    "verify:template-file": "tsx scripts/verify-template-file.ts",
    "verify:atomic-write": "tsx scripts/verify-atomic-write.ts",
    "verify:daily-review-blocks": "tsx scripts/verify-daily-review-blocks.ts",
    "verify:ai-runner": "tsx scripts/verify-ai-runner.ts",
    "verify:rc": "npm run verify:rc-sync && npm run verify:rc-strings && npm run verify:settings-sync && npm run verify:delete-review && npm run verify:no-captures && npm run verify:daily-command && npm run verify:renderer-route && npm run verify:main-window-structure && npm run verify:rc-ui && npm run verify:ai-markers && npm run verify:ai-hash && npm run verify:scan-decision && npm run verify:ai-stats && npm run verify:ai-settings && npm run verify:profile-ops && npm run verify:section-config && npm run verify:openai-client && npm run verify:template-file && npm run verify:atomic-write && npm run verify:daily-review-blocks && npm run verify:ai-runner && npm run verify:ai-timer && npm run verify:weekly && npm run verify:export-reports && npm run verify:recognize-template && npm run verify:monthly && npm run verify:redaction && npm run verify:section-overrides && npm run verify:fuzzy-match && npm run verify:onboarding-state && npm run verify:recognize-report && npm run verify:obsidian-template-center && npm run verify:obsidian-template-recognition && npm run verify:obsidian-template-ui && npm run verify:template-source-settings && npm run verify:daily-markdown-template && npm run verify:daily-template-markers && npm run verify:source-materials && npm run verify:unified-template-recognition && npm run verify:template-source-i18n",
    "verify:ai-timer": "tsx scripts/verify-ai-timer.ts",
    "verify:weekly": "tsx scripts/verify-weekly.ts",
    "verify:export-reports": "tsx scripts/verify-export-reports.ts",
    "verify:recognize-template": "tsx scripts/verify-recognize-template.ts",
    "verify:monthly": "tsx scripts/verify-monthly.ts",
    "verify:redaction": "tsx scripts/verify-redaction.ts",
    "verify:section-overrides": "tsx scripts/verify-section-overrides.ts",
    "verify:fuzzy-match": "tsx scripts/verify-fuzzy-match.ts",
    "verify:onboarding-state": "tsx scripts/verify-onboarding-state.ts",
    "verify:recognize-report": "tsx scripts/verify-recognize-report.ts",
    "verify:obsidian-template-center": "tsx scripts/verify-obsidian-template-center.ts",
    "verify:obsidian-template-recognition": "tsx scripts/verify-obsidian-template-recognition.ts",
    "verify:obsidian-template-ui": "tsx scripts/verify-obsidian-template-ui.ts",
    "verify:template-source-settings": "tsx scripts/verify-template-source-settings.ts",
    "verify:daily-markdown-template": "tsx scripts/verify-daily-markdown-template.ts",
    "verify:daily-template-markers": "tsx scripts/verify-daily-template-markers.ts",
    "verify:source-materials": "tsx scripts/verify-source-materials.ts",
    "verify:unified-template-recognition": "tsx scripts/verify-unified-template-recognition.ts",
    "verify:template-source-i18n": "tsx scripts/verify-template-source-i18n.ts",
    "verify:settings-v2-ai-account": "tsx scripts/verify-settings-v2-ai-account.ts",
    "verify:settings-v2-window-mode": "tsx scripts/verify-settings-v2-window-mode.ts",
    "verify:task-list-interactions": "tsx scripts/verify-task-list-interactions.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "electron-store": "7.0.3",
    "framer-motion": "^11.18.2",
    "koffi": "^3.0.2",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "34.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.dailytodo.app",
    "productName": "DailyTodo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "artifactName": "DailyTodo.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
