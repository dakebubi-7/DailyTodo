{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "electron/**/*.ts", "shared/**/*.ts"]
}
